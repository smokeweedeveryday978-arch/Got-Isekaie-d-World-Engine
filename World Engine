        "iron-bridge": {
          "description": "A dwarven-built bridge of rust-proof iron spanning the widest river channel in the fen — the only reliable crossing point for caravans. A toll station and guard post guard the crossing.",
          "paths": [
            "toll-village"
          ]
        },
        "toll-village": {
          "description": "A small settlement at the bridge's south end — toll office, supply shop, a Guild waystation, and an inn whose owner makes a comfortable living from travelers who have no other crossing option.",
          "paths": [
