    "Crossroads Inn": {
      "complexityType": "simple",
      "detailType": "basic",
      "name": "Crossroads Inn",
      "radius": 3,
      "region": "Fálgarr Marches",
      "x": 5,
      "y": 10,
      "basicInfo": "The only reliable inn between Solasreach and Caelvir — a large timber-and-stone building at the junction of two trade trails, run by a retired adventurer couple who know the Marches better than anyone alive. The inn is warm, the food is solid, the beds are clean, and the ale is strong enough to make you forget you are sleeping in monster territory. The common room is where Marches information changes hands — quest leads, monster sightings, trail conditions, and the occasional romantic connection between travelers grateful to have survived the day.",
      "hiddenInfo": "The innkeepers keep a hidden shelter beneath the root cellar — reinforced, warded, and stocked for a month. They built it after a monster stampede nearly killed everyone. They do not advertise it. They do use it when necessary.",
      "factions": [],
      "areas": {
        "Entrance": {
          "description": "The way into Crossroads Inn.",
          "paths": [
            "The Common Room"
          ]
        },
        "The Common Room": {
          "description": "Ale, a fire, and every road in the Marches meeting under one roof. Rumours are the house specialty.",
          "paths": [
            "Entrance",
            "The Stables"
          ]
        },
        "The Stables": {
          "description": "Tired horses, a watchful stablehand, and the odd traveller who would rather not be seen at the fire.",
          "paths": [
            "The Common Room"
          ]
        }
      },
      "visited": false,
      "lastVisitedTick": -1,
      "visitedAreas": []
    },
    "Frostvein Pass": {
      "areas": {
        "trade-road": {
          "description": "The main pass road — wide enough for caravans, paved in dwarven stone, flanked by avalanche shelters and waystations. The only reliable route between Dúnbheal and the southern kingdoms in winter.",
          "paths": [
            "watchtower"
          ]
        },
        "watchtower": {
          "description": "A fortified watchtower at the pass's highest point — commands a view of both Dúnbheal's mountain road and the descent toward Scáthfenn. Garrisoned jointly by dwarven sentries and a token Solasreach Knight presence.",
          "paths": [
            "trade-road"
          ]
        }
      },
      "complexityType": "complex",
      "detailType": "basic",
      "factions": [
        "Royal Knights of Solasreach",
        "Adventurers' Guild"
      ],
      "name": "Frostvein Pass",
      "radius": 4,
      "region": "Dúnbheal",
      "x": 30,
      "y": -5,
      "basicInfo": "The fortified mountain pass connecting Dúnbheal to the southern lowlands — the only trade route that stays passable year-round. Frostvein is cold, windswept, and heavily defended: the watchtower at its peak commands both approaches, and a joint dwarven-Solasreach garrison keeps the road safe from mountain monsters and bandits. The pass is also the only way into or out of Dúnbheal that does not involve a very long boat ride or a very reckless teleport.",
      "hiddenInfo": "The watchtower's foundation stones are pre-Collapse. The original structure was not a watchtower — it was a gate. The gate still opens if you know the key, leading to a shortcut through the mountain that no cart could navigate.",
      "visited": false,
      "lastVisitedTick": -1,
      "visitedAreas": []
    },
    "Greyraven Camp": {
      "complexityType": "simple",
      "detailType": "basic",
      "name": "Greyraven Camp",
      "radius": 4,
      "region": "Fálgarr Marches",
      "x": 9.24730880654188,
      "y": -20.75269119345812,
      "basicInfo": "A semi-permanent bandit and mercenary camp in the southern Marches — a collection of tents, lean-tos, and the occasional stolen wagon arranged around a central fire pit. Greyraven Camp is where the Marches' outlaws gather to trade, recruit, and occasionally fight each other for leadership. The current boss is a former B-rank adventurer who quit the Guild after a disagreement about whose fault a party wipe was. She runs the camp with pragmatic fairness: no raiding within the Marches (bad for business), no harming travelers who pay the toll, and no asking questions about what people need to disappear for.",
      "hiddenInfo": "The camp's leader maintains a side deal with the Warden Circle, reporting demon-tinged activity in exchange for the Wardens looking the other way about her other business. She is not loyal to anyone. She is practical about survival.",
      "factions": [],
      "visited": false,
      "lastVisitedTick": -1,
      "visitedAreas": []
    },
    "Hermit's Falls": {
      "complexityType": "simple",
      "detailType": "basic",
      "name": "Hermit's Falls",
      "radius": 3,
      "region": "Bréanriv Lowlands",
      "x": -10,
      "y": -25,
      "basicInfo": "A waterfall retreat in the southwestern Lowlands — a cascade feeding a deep, clear pool, with a hermit's cave behind the water and a grove of fruit trees on the bank. The current hermit is a retired A-rank adventurer who gave up the life after deciding that the world was too loud. She does not want company, does not want quests, and does not want to discuss her former career. She will, however, heal anyone who asks politely, and she will absolutely notice if you and your companion decide the pool looks too inviting to skip.",
      "hiddenInfo": "The hermit is the former Grand Commander of the Royal Knights — the one before the current one. She faked her death rather than serve a king she considered unworthy. The current Grand Commander knows she is alive and has deliberately not pursued her.",
      "factions": [],
      "visited": false,
      "lastVisitedTick": -1,
      "visitedAreas": []
    },
    "Obsidian Gates": {
      "areas": {
        "checkpoint-hall": {
          "description": "A screening chamber where all visitors to the Deep Court are inspected — weapons checked, identifications verified, and a brief magical scan that detects most concealment spells.",
          "paths": [
            "gate-fortress"
          ]
        },
        "gate-fortress": {
          "description": "The massive fortified entrance to the Deep Court and the Old City beyond — obsidian doors twenty feet tall, warded with every protection the Forge Lords know, guarded by elite dwarven sentinels and two combat constructs.",
          "paths": [
            "checkpoint-hall"
          ]
        }
      },
      "complexityType": "complex",
      "detailType": "basic",
      "factions": [
        "Forge Lords"
      ],
      "name": "Obsidian Gates",
      "radius": 4,
      "region": "Dúnbheal",
      "x": 10,
      "y": -30,
      "basicInfo": "The fortified entrance to Dúnbheal's deepest levels — obsidian doors twenty feet tall, warded with every protection the Forge Lords possess, and guarded by sentinels who have not failed a shift in three centuries. The Gates are the last checkpoint before the Deep Court, and beyond that, the sealed passages to the Old City that no one is supposed to know about. The fortress around the gates is functional, imposing, and carries the implicit promise that whatever is down there, the dwarves are keeping it contained.",
      "hiddenInfo": "One of the combat constructs guarding the Gates has been compromised by whatever is waking in the Old City. It still follows orders. It also reports everything it sees to something below.",
      "visited": false,
      "lastVisitedTick": -1,
      "visitedAreas": []
    },
    "Palebark Ruins": {
      "complexityType": "wilderness",
      "detailType": "basic",
      "name": "Palebark Ruins",
      "radius": 5,
      "region": "Caelvir",
      "x": -15,
      "y": -30,
      "basicInfo": "The remains of an elven city that fell during the Catastrophe — pale bone-white trees now hollow and cracked, graceful arches now broken, plazas now carpeted in luminous moss and the quiet hum of residual enchantments. The ruins are a C-to-B rank dungeon: mutated forest creatures, unstable magical effects, and the occasional intact workshop containing pre-Collapse artifacts. The Wardens have declared it off-limits to casual exploration, which of course makes it one of the most popular targets for ambitious adventurers.",
      "hiddenInfo": "The city fell because its inhabitants tried to harvest the World-Tree's predecessor for power. The ruins still carry the echo of that arrogance — and the curse that answered it. Adventurers who take artifacts from Palebark carry a faint compulsion to return.",
      "factions": [],
      "visited": false,
      "lastVisitedTick": -1,
      "visitedAreas": []
    },
    "The Deep Court": {
      "areas": {
        "honor-gallery": {
          "description": "A hall of statues commemorating the kingdom's greatest crafters and warriors — each statue is carved by the honoree's own hand, making the gallery part monument, part autobiography.",
          "paths": [
            "throne-chamber"
          ]
        },
        "residential-warrens": {
          "description": "The living quarters of the Deep Court's permanent residents — cozy stone apartments with hearths, workshops, and the kind of domestic warmth that surprises surface-dwellers who expected dwarven homes to be grim.",
          "paths": [
            "throne-chamber"
          ]
        },
        "throne-chamber": {
          "description": "A vast underground hall where the King of Dúnbheal holds court — crystal-lit, stone-pillared, with a throne carved from a single volcanic obsidian flow. The acoustics carry a whisper to every corner.",
          "paths": [
            "honor-gallery",
            "residential-warrens"
          ]
        }
      },
      "complexityType": "complex",
      "detailType": "detailed",
      "factions": [
        "Forge Lords"
      ],
      "name": "The Deep Court",
      "radius": 5,
      "region": "Dúnbheal",
      "x": 5,
      "y": -15,
      "basicInfo": "The underground palace of Dúnbheal's royal family — a city-within-a-city of stone halls, crystal-lit galleries, and residential warrens that combine military efficiency with genuine domestic warmth. The King of Dúnbheal holds court here, advised by the Forge Lords and served by a household that has run the same way for three hundred years. The Deep Court is beautiful in a dwarven way — grand without being ostentatious, powerful without being threatening. Access is by invitation only; the guards at the entrance have not let an uninvited guest pass in living memory.",
      "hiddenInfo": "The King knows about the Old City and has personally visited its outer chambers. He has not told the Forge Lords what he found there. He has not slept well since.",
      "visited": false,
      "lastVisitedTick": -1,
      "visitedAreas": []
    },
    "The Mana Heart": {
      "areas": {
        "guardian-post": {
          "description": "A fortified position overlooking the Demi-Plane's approaches — not that there are many ways in, but the Chamberlain takes no chances. Wards pulse from stone pillars. A guardian entity patrols the perimeter — not a living thing but a construct of the Demi-Plane's defensive will, shaped by the creator's intentions and the oath-sworn's combat experience. The guardian does not speak. It watches. It waits. It only acts when something that should not be here appears.",
          "paths": [
            "mana-well"
          ]
        },
        "mana-well": {
          "description": "The convergence point where the Demi-Plane's ambient mana gathers and circulates. A pool of liquid light — not water, not fire, but concentrated potential that pulses with the dimension's health. The air hums here. Standing near the well makes magic feel easier, more responsive. The Chamberlain uses it as a diagnostic tool — the well's brightness, colour, and pulse rate tell them everything about the Demi-Plane's condition. When the well is bright and steady, all is well. When it dims or flickers, something is wrong.",
          "paths": [
            "guardian-post"
          ]
        }
      },
      "complexityType": "complex",
      "detailType": "detailed",
      "factions": [],
      "name": "The Mana Heart",
      "radius": 3,
      "region": "Heartgate Basin",
      "x": 5,
      "y": -15,
      "basicInfo": "The mana infrastructure and defensive core of the Demi-Plane. When mana infrastructure or defense development reaches Growing, the Chamberlain leads the creator here — to a well of concentrated mana that makes the entire dimension function better, and to a guardian post that protects what has been built. This is where the Demi-Plane's hidden machinery lives: the channels that distribute ambient energy, the wards that detect intrusion, and the diagnostic tools the Chamberlain uses to assess the dimension's health.",
      "hiddenInfo": "The mana well is connected to the Demi-Plane's anchor-sworn bond. If that bond weakens, the well dims. If the bond breaks entirely, the well goes dark and the Demi-Plane begins to collapse inward. The guardian entity is also bonded to the well — it draws its existence from the mana concentration. If the well fails, the guardian dissolves. The Chamberlain knows this but frames it as a maintenance concern rather than an existential threat, because they have learned that existential threats make creators anxious and anxious creators make poor development decisions.",
      "visited": false,
      "lastVisitedTick": -1,
      "visitedAreas": []
    },
    "Mistveil Spring": {
      "complexityType": "simple",
      "detailType": "basic",
      "name": "Mistveil Spring",
      "radius": 4,
      "region": "Fálgarr Marches",
      "x": 25,
      "y": 5,
      "basicInfo": "A hidden hot-spring oasis in the eastern Marches — a steaming pool in a sheltered grotto, surrounded by mist-wrapped trees and the kind of silence that makes you forget there are monsters outside. Mistveil is not on any official map; adventurers find it by word of mouth from other adventurers who found it the same way. The spring is small but deep, the water is perfect, and the grotto's acoustics mean you can hear anyone approaching long before they see you. It is the best date spot in the Marches, provided you both survive the walk there.",
      "hiddenInfo": "The spring's water contains a rare mineral compound that produces a deep, restorative calm — tension melts, stress fades, and visitors find themselves more open and honest than usual. The effect is subtle but consistent: people say things they meant to say earlier, admit feelings they were holding back, and relax guards they did not realize they were keeping. The locals know. Adventurers who discover this usually figure it out around the second visit.",
      "factions": [],
      "visited": false,
      "lastVisitedTick": -1,
      "visitedAreas": []
    },
    "The Hollow Tree": {
      "complexityType": "simple",
      "detailType": "basic",
      "name": "The Hollow Tree",
      "radius": 3,
      "region": "Scáthfenn",
      "x": -5,
      "y": -20,
      "basicInfo": "A colossal dead tree in the western marsh — its hollow trunk large enough to shelter a dozen people, its bare branches visible for miles in every direction. The Hollow Tree is a landmark, an emergency shelter, and a place of quiet significance. Travelers leave offerings at its roots. The wood is petrified and indestructible; no one knows what species it was or how it died. The inside is dry, warm, and smells faintly of cedar. Spending a night here is considered good luck by marsh-folk.",
      "hiddenInfo": "The tree is not dead — it is in a state of suspended animation that predates the marsh itself. It is older than any known civilization in Aerfála. If the right conditions were met, it would grow again. No one knows what those conditions are, and the tree is not telling.",
      "factions": [],
      "visited": false,
      "lastVisitedTick": -1,
      "visitedAreas": []
    },
    "The Magma Wells": {
      "complexityType": "wilderness",
      "detailType": "basic",
      "name": "The Magma Wells",
      "radius": 4,
      "region": "Dúnbheal",
      "x": -16.106244584051392,
      "y": -26.106244584051392,
      "basicInfo": "Volcanic geothermal springs in a remote mountain basin — the hottest natural baths in Aerfála, accessible only by a narrow mountain trail that keeps casual visitors away. The Magma Wells are legendary among adventurers who know: the water temperature is barely tolerable, the mineral content turns your skin briefly luminescent, and the deep-sourced heat produces a euphoric lassitude that makes the challenging hike more than worthwhile. Dwarven couples consider the Wells the most romantic spot in the kingdom. The fact that the trail is dangerous, the water is scalding, and there are fire-elementals in the vicinity only enhances the appeal.",
      "hiddenInfo": "The Magma Wells sit directly above a magma chamber that is connected to the Old City's ventilation system. The fire-elementals here are not wild — they are escapees from the Old City's containment, too small and passive to be a real threat. Yet.",
      "factions": [],
      "visited": false,
      "lastVisitedTick": -1,
      "visitedAreas": []
    },
    "The Sunken Road": {
      "complexityType": "simple",
      "detailType": "basic",
      "name": "The Sunken Road",
      "radius": 3,
      "region": "Scáthfenn",
      "x": -20,
      "y": 5,
      "basicInfo": "An ancient paved road that once connected Dúnbheal to Solasreach — now mostly underwater, with only occasional stone sections visible above the marsh surface. The Road is a navigational aid and a hazard: following it is the most reliable way through the fen, but the sections that are visible are visible because the ground around them has eroded, creating deep water channels on both sides. Walking the Road requires balance, timing, and the acceptance that you will get wet. Adventurers use it as a shortcut; the marsh uses it as a trap.",
      "hiddenInfo": "The Road was not built for trade. It was built as a containment perimeter around something that was sealed beneath the marsh long before Dúnbheal existed. The stones are ward-anchors. The water is rising because the wards are failing.",
      "factions": [],
      "visited": false,
      "lastVisitedTick": -1,
      "visitedAreas": []
    },
    "Hollow Cathedral": {
      "complexityType": "wilderness",
      "detailType": "basic",
      "name": "Hollow Cathedral",
      "radius": 4,
      "region": "Solasreach",
      "x": -25,
      "y": -5,
      "basicInfo": "A vast ruin in the western hills — the skeletal remains of a pre-Collapse cathedral whose stone arches still stand despite having no roof, no floor, and no congregation for centuries. Faint hymns echo from nowhere on windless nights. Adventurers explore the catacombs beneath for relics and gold, though the deeper chambers have a habit of rearranging themselves between visits. The Cathedral is a popular F-to-D rank dungeon, hazardous enough to test novices but rarely fatal to prepared parties.",
      "hiddenInfo": "The Cathedral was not built to worship any god — it was built to contain one. The entity sealed beneath the altar is stirring, and the rearranging chambers are its dreams reshaping the architecture around it.",
      "factions": [],
      "visited": false,
      "lastVisitedTick": -1,
      "visitedAreas": []
    },
    "Moonsilver Glade": {
      "complexityType": "simple",
      "detailType": "basic",
      "factions": [
        "Warden Circle"
      ],
      "name": "Moonsilver Glade",
      "radius": 4,
      "region": "Caelvir",
      "x": -20,
      "y": 15,
      "basicInfo": "A sacred grove deep in Caelvir's interior where moonlight filters through the canopy in beams of pure silver, illuminating a natural amphitheater of moss and standing stones. The Glade is the site of elven rituals, seasonal festivals, and the rare gatherings where the forest spirits manifest to negotiate with the Elders. During the full moon, the air literally sparkles — and the elves celebrate with music, wine, and dances that outsiders find mesmerizing and faintly intoxicating. Warden patrols keep the Glade protected; respectful visitors are tolerated.",
      "hiddenInfo": "The standing stones are not natural — they are the petrified remains of the previous World-Tree, which died in a catastrophe the Elders refuse to discuss. The current World-Tree grew from its predecessor's ashes.",
      "visited": false,
      "lastVisitedTick": -1,
      "visitedAreas": []
    },
    "Old Stone Bridge": {
      "complexityType": "simple",
      "detailType": "basic",
      "name": "Old Stone Bridge",
      "radius": 3,
      "region": "Bréanriv Lowlands",
      "x": -5,
      "y": -15,
      "basicInfo": "An ancient bridge spanning the Lowlands' widest river — dwarf-made, indestructible, and wide enough for two wagons to pass. The Bridge charges no toll, but the inn at the south end — the Bridgestone — charges very reasonable rates and makes an unreasonable profit. The inn is the de facto social center for miles: river traffic, road traffic, and the occasional adventurer party all converge here. The Bridgestone's owner is a retired C-rank adventurer who solves disputes by suggesting the disputants settle it in the ring behind the stable.",
      "hiddenInfo": "The Bridge's keystone is inscribed with a ward that the dwarves who built it never explained. The ward activates when something powerful crosses the bridge — and it has activated three times in the last month.",
      "factions": [],
      "visited": false,
      "lastVisitedTick": -1,
      "visitedAreas": []
    },
    "The Ashen Steppe": {
      "areas": {
        "traders-camp": {
          "description": "A semi-permanent encampment of cross-border traders who operate in the gray zone between mortal and demon territory. Tents, wagons, and the specific tension of people doing business with both sides while belonging to neither.",
          "paths": [
            "watchtower-ruin"
          ]
        },
        "watchtower-ruin": {
          "description": "The remains of a border watchtower — collapsed on one side, still standing on the other. Used as a landmark by smugglers and a rendezvous by patrols from both sides. The mortal side's border markers are visible from the top on a clear day.",
          "paths": [
            "traders-camp"
          ]
        }
      },
      "complexityType": "complex",
      "detailType": "basic",
      "factions": [],
      "name": "The Ashen Steppe",
      "radius": 5,
      "region": "Demon Realm",
      "x": -20,
      "y": -10,
      "basicInfo": "The contested frontier zone where the Demon Realm meets mortal territory — a broad expanse of dark grassland and low hills where the miasma thins to something mortals can breathe without immediate discomfort. Border markers from both sides crisscross the landscape, some official, some centuries old. Smugglers, independent traders, scouts, and the occasional lost adventurer all pass through. Both sides patrol here; neither controls it fully. This is where mortal and demon societies overlap at the edges — not peacefully, but practically.",
      "hiddenInfo": "A demon scholar lives in the watchtower ruin — an elderly hermit who was once a court translator and who can read the ancient script of the citadel's foundation inscriptions. They defected from the Demon Lord's court decades ago and have been left alone because what they know is more dangerous to speak than to silence. The player may need them for The Vault's Secret quest.",
      "visited": false,
      "lastVisitedTick": -1,
      "visitedAreas": []
    },
    "The Demon Market": {
      "areas": {
        "broker-alcove": {
          "description": "A recessed corner where the information broker operates — part office, part shrine to accumulated secrets. The broker's species and loyalties are unclear. Their prices are precise.",
          "paths": [
            "market-square"
          ]
        },
        "market-square": {
          "description": "The open center of the Demon Market — stalls, carts, and the perpetual negotiation that passes for commerce in a realm where barter is king and information is the real currency. The miasma is thinner here, which is either a sign of good ventilation or a sign that someone is siphoning it.",
          "paths": [
            "broker-alcove"
          ]
        }
      },
      "complexityType": "complex",
      "detailType": "basic",
      "factions": [
