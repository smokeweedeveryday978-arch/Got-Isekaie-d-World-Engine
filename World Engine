    "The Gilded Ruins": {
      "complexityType": "wilderness",
      "detailType": "basic",
      "name": "The Gilded Ruins",
      "radius": 4,
      "region": "Fálgarr Marches",
      "x": -25,
      "y": -5,
      "basicInfo": "The collapsed remains of a Solasreach noble's country manor — once gilded and grand, now a tangle of broken walls, collapsed floors, and the residual magic of whatever the noble was doing here before he vanished. The Gilded Ruins are a C-rank dungeon with a notorious reputation: the architecture shifts slightly between visits, some rooms are warm when they should not be, and the golden fixtures on the walls are not decoration — they are wards. Something was summoned here, something was bound here, and the bindings are not what they used to be.",
      "hiddenInfo": "The noble was summoning demons for personal power. The demons he summoned are still here — bound by the failing wards, patient, and very interested in anyone who might accidentally complete the release ritual by exploring too thoroughly.",
      "factions": [],
      "visited": false,
      "lastVisitedTick": -1,
