        "fortress": {
          "description": "A stone fortress raised on the only solid ground for miles — squat, damp, and determined. The garrison rotates between Solasreach knights and Guild-hired scouts. The commander's office has a chart of the marsh's shifting paths.",
          "paths": [
            "marsh-dock"
          ]
        },
        "marsh-dock": {
          "description": "A wooden dock on the fortress's south side where flat-bottomed marsh boats load and unload — the only reliable way to move goods through the fenlands.",
