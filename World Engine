    "Scáthfenn": {
      "factions": [
        "Adventurers' Guild"
      ],
      "name": "Scáthfenn",
      "npcLevelRange": {
        "max": 30,
        "min": 5
      },
      "realm": "Anime Fantasy",
      "x": 0,
      "y": 1,
      "basicInfo": "The marshlands sprawl between Dúnbheal's southern foothills and Solasreach's northern border — a gray-green expanse of peat bogs, willow thickets, and fog that never fully lifts. Roads here are suggestions; the real paths shift with the water table and the season. Blackmire Fort anchors the region's military presence, but most of Scáthfenn belongs to the frog-beastkin of Mirehaven, the witch covens of Witchlight Hollow, and whatever lives in the water that locals do not name. Half-submerged keeps, sunken roads, and bog springs that steam in the cold make this region eerie, atmospheric, and oddly romantic if you do not mind the mosquitoes.",
      "hiddenInfo": ""
    },
    "Solasreach": {
      "factions": [
        "Royal Knights of Solasreach",
        "Adventurers' Guild"
