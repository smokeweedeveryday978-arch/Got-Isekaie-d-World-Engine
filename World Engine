      "visitedAreas": []
    },
    "Golden Walk": {
      "name": "Golden Walk",
      "basicInfo": "The ridge path along the highest crest of The Southroll — a spontaneous footpath the dimension seems to have worn for the pleasure of it, winding hilltop to hilltop through perpetual golden light. Warm-feather birds roost along its length, grass spirits part the growth a stride ahead of walkers, and from the crest's center the whole dimension is faintly visible: a pocket-sized world laid out under endless afternoon.",
      "x": 15,
      "y": 25,
      "radius": 2,
      "region": "The Southroll",
      "complexityType": "simple",
      "detailType": "detailed",
      "known": true,
      "hiddenInfo": "The Walk's path was never laid or trodden into being; it appeared complete the morning after the Southroll stabilized — the only fully finished feature the dimension ever produced unasked. Walking its full length in a single stretch grants mild, harmless euphoria and (the Chamberlain suspects) slightly improved mana sensitivity. Small spirit dens thread the embankments under the path: grass spirits and foxes share them without tension. Springs surface along the route after heavy warm days, occasionally ringing with firefly dust in the water.",
      "factions": [],
      "visited": false,
