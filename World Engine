    "The Gateway Clearing": {
      "areas": {
        "chamberlain-quarters": {
          "description": "A modest but comfortable space just off the gateway — the Chamberlain's home base. A desk covered in notes and development proposals. A small hearth that burns without fuel. A window that looks out onto the current state of the Demi-Plane — whatever has been built so far, the Chamberlain can see it from here. This is where development requests are discussed and progress is reported.",
          "paths": [
